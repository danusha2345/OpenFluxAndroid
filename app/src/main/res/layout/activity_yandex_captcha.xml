<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#090d16">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/captcha_web_description"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

    <WebView
        android:id="@+id/captchaWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/captchaClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/captcha_close" />

        <Button
            android:id="@+id/captchaSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/captcha_save" />
    </LinearLayout>
</LinearLayout>
